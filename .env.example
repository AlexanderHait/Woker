# Every setting is optional; these are the defaults the service ships with.
# Copy to .env only if you want to override something.

INTAKE_DATABASE_URL=postgresql://intake:intake@localhost:55432/intake
INTAKE_LOG_LEVEL=INFO

# Retry policy: 5s, 10s, 20s, 40s ... capped at 1h, 34 attempts ~ 24.4 hours in total.
INTAKE_RETRY_BASE_SECONDS=5
INTAKE_RETRY_FACTOR=2
INTAKE_RETRY_CAP_SECONDS=3600
INTAKE_RETRY_MAX_ATTEMPTS=34
INTAKE_RETRY_JITTER_RATIO=0.2

# Per-attempt timeouts. read_timeout is generous on purpose - see app/config.py.
INTAKE_CONNECT_TIMEOUT_SECONDS=5
INTAKE_READ_TIMEOUT_SECONDS=30
INTAKE_ATTEMPT_DEADLINE_SECONDS=45
INTAKE_LEASE_SECONDS=90

# Worker sizing.
INTAKE_WORKER_CONCURRENCY=32
INTAKE_WORKER_BATCH_SIZE=16
INTAKE_MAX_CLAIMS_PER_ORIGIN=4

# Undelivered longer than this shows up in /v1/problems.
INTAKE_DEFAULT_STALE_MINUTES=15
